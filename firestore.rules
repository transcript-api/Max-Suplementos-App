rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper de autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Regla de aislamiento estricto por usuario:
    // Un atleta solo puede leer y modificar sus propios documentos y telemetría.
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Subcolecciones privadas del usuario
      match /dailyLogs/{logId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      match /progressPhotos/{photoId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /foodHistory/{foodId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /supplementHistory/{suppId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /ai_conversations/{convId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
        
        match /messages/{messageId} {
          allow read, write: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      match /xp_transactions/{txId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        // Las transacciones de XP se escriben mediante servidor o validación
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Clasificación de liga / Rankings:
    // Todos pueden leer la tabla de posiciones pública, pero solo cada usuario puede actualizar su propio score.
    match /rankings/{entry} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == entry;
    }

    // Muro de comunidad / Social atletas:
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;
      }
    }

    // Cupones y promociones MAX Suplementos:
    // Solo lectura de estado, el canje se procesa exclusivamente vía backend
    match /coupons/{couponCode} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo accesible por backend/admin
    }
  }
}
